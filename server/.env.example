# Copia este archivo como `.env` y completa los valores. El archivo `.env` NO se sube a Git.
# Guía paso a paso: docs/integracion-whatsapp.md

# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Cuenta para iniciar sesión en Colibri. Se crea al arrancar el servidor si no existe.
# La contraseña debe tener al menos 8 caracteres. Si la cambias aquí y reinicias, se actualiza.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# Base de datos PostgreSQL. Si lo dejas vacío, las conversaciones se guardan en memoria
# y se pierden al reiniciar. Formato: postgresql://usuario:clave@localhost:5432/colibri
# Las tablas se crean solas al iniciar el servidor.
DATABASE_URL=

# WhatsApp (Meta). Déjalos vacíos si todavía no configuras WhatsApp.
# Texto que tú inventas; debe ser igual al que pongas al registrar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (Configuración de la app > Básica). Sirve para validar la firma.
WHATSAPP_APP_SECRET=
# Token de acceso para enviar mensajes.
WHATSAPP_ACCESS_TOKEN=
# Identificador del número de teléfono (Configuración de la API de WhatsApp).
WHATSAPP_PHONE_NUMBER_ID=
# Identificador de la cuenta de WhatsApp Business (WABA). Solo lo usa `pnpm whatsapp:subscribe`.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Versión de la API de Meta (usa la vigente).
GRAPH_API_VERSION=v23.0

# Instagram (Meta). Déjalos vacíos si todavía no configuras Instagram.
# Texto que tú inventas; debe ser igual al que pongas al registrar el webhook de Instagram.
INSTAGRAM_VERIFY_TOKEN=
# Clave secreta de la app de Instagram (Instagram > Configuración de la API con inicio de sesión de Instagram).
INSTAGRAM_APP_SECRET=
# Token de acceso de la cuenta de Instagram (se genera en el mismo panel).
INSTAGRAM_ACCESS_TOKEN=
# Identificador de la cuenta profesional de Instagram (el que muestra ese panel junto a la cuenta).
INSTAGRAM_ACCOUNT_ID=
# Solo para demostraciones: "true" simula Instagram sin Meta (ver docs/integracion-instagram.md).
# No funciona con NODE_ENV=production.
INSTAGRAM_SIMULATE=
# Depuración: "true" imprime en la consola el cuerpo completo de cada evento de Instagram
# (incluye el texto de los mensajes). Apágalo cuando termines.
INSTAGRAM_DEBUG_WEBHOOK=

# Facebook Messenger (Meta). Déjalos vacíos si todavía no configuras Messenger.
# Guía: docs/integracion-messenger.md
# Texto que tú inventas; debe ser igual al que pongas al registrar el webhook de Messenger.
MESSENGER_VERIFY_TOKEN=
# Clave secreta de la app (Configuración de la app > Básica). Si usas la misma app de WhatsApp, es el mismo valor.
MESSENGER_APP_SECRET=
# Token de la página de Facebook (configuración de la API de Messenger > Generar token).
MESSENGER_PAGE_ACCESS_TOKEN=
# Identificador de la página. `pnpm --filter @colibri/server messenger:subscribe` te dice cuál es.
MESSENGER_PAGE_ID=
# Depuración: "true" imprime el cuerpo completo de cada evento (incluye el texto). Apágalo al terminar.
MESSENGER_DEBUG_WEBHOOK=

# --- Respuestas automáticas ("Contesta solo") ---
# Confianza mínima del analizador (0 a 1) para contestar solo. Por defecto 0.7.
AUTOREPLY_MIN_CONFIDENCE=
# Zona horaria del negocio (decide "hoy" y "mañana" en las respuestas de horario). Por defecto America/Costa_Rica.
AUTOREPLY_TIME_ZONE=
